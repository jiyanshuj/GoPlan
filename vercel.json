{
  "version": 2,
  "builds": [
    {
      "src": "goplan/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.12"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "goplan/wsgi.py"
    }
  ],
  "installCommand": "pip install --break-system-packages -r requirements.txt"
}
